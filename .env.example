# Enable Banking Application ID (Client ID) generado en el panel de control de Enable Banking
CLIENT_ID=your-application-id-here

# Ruta absoluta o relativa al archivo de clave privada RSA (.pem) asociado a tu aplicacion
KEY_PATH=./keys/private_key.pem

# Puerto en el que arranca el servidor Express
PORT=3000

# Credenciales de acceso al panel web (formulario de login)
APP_USERNAME=admin
APP_PASSWORD=change-me

# Secreto usado para firmar los JWT de sesion del panel (usa un valor largo y aleatorio)
SESSION_SECRET=change-me-too

# Clave de API de OpenRouter (https://openrouter.ai/keys) para el endpoint /api/analyze
OPENROUTER_API_KEY=your-openrouter-api-key-here

# URL publica de tu app y nombre, exigidos por OpenRouter en las cabeceras HTTP-Referer y X-Title
APP_URL=http://localhost:3000
APP_NAME=Money AI

# Configuracion opcional de OpenRouter (si se omiten, se usan estos mismos valores por defecto)
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_SYSTEM_PROMPT=Eres un asesor financiero personal experto y cercano. Analiza los movimientos bancarios en formato JSON que te proporciona el usuario y responde en español, en formato Markdown, con recomendaciones concisas.
